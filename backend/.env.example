# IT-ISEP server configuration (backend/)
# Copy this file to .env and adjust.

# Port the server listens on. NOTE: 8080 is often taken by XAMPP/Apache,
# which is why the app defaults to 8081. Set PORT to anything free in .env.
PORT=8081

# First-run default administrator. This account is created only when the
# users table is empty. After that, administrators are managed from the
# Admin dashboard ("Administrators" tab) and from the database, not from
# these variables. Login at /login.html (default: admin / admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# MySQL connection. The database is created automatically if it does not exist.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crud

# Email notifications
# -------------------
# The admin dashboard can receive every request (availability checks, quote
# requests, chat messages, new user registrations) by email. The recipient is
# configured in the admin dashboard ("Mail" tab) and defaults to MAIL_TO below.
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and use
# an App Password (Google Account -> Security -> App passwords) for SMTP_PASS.
MAIL_TO=fuesohyushaou@gmail.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=IT-ISEP LTD Website